      "~/.pi/agent/auth.json",
      "~/.pi/agent/models-store.json",
      "~/.config/opencode",
      "~/.config/stripe",
      "~/.config/github-copilot",
      "~/.config/sops",
      "~/.cargo/credentials.toml",
      "~/.cargo/credentials",
      "~/.mongodb",
      "~/ns-owner.key",
      "~/Library/Keychains",
      "~/.emulator_console_auth_token", ".env", "~/.env",
      "/Users/rachitsrivastava/Library/CloudStorage/ProtonDrive-privacyprophetHQ@proton.me-folder/Obs"
    ],
    "allowWrite": [".", "/tmp", "/private/tmp", "~/.pi/agent/sessions"],
    "denyWrite": [
      ".env", ".env.*",
      "*.pem", "*.key", "*.p12", "*.pfx",
      "~/.pi/agent/settings.json",
      "~/.pi/agent/extensions",
      "~/.pi/agent/agents",
      "~/Library"
