#!/bin/sh
case "$0" in
  */*) pi_launcher="$0" ;;
  *) pi_launcher=$(command -v "$0") || exit 127 ;;
esac
while [ -L "$pi_launcher" ]; do
  pi_link=$(readlink "$pi_launcher") || exit 1
  case "$pi_link" in
    /*) pi_launcher="$pi_link" ;;
    *) pi_launcher=${pi_launcher%/*}/$pi_link ;;
  esac
done
pi_bin_dir=${pi_launcher%/*}
pi_agent_dir=${pi_bin_dir%/*}
pi_current_file=$pi_agent_dir/install/current-version
if ! IFS= read -r pi_current_version < "$pi_current_file"; then
  printf 'Could not read managed Pi version from %s.\n' "$pi_current_file" >&2
  exit 1
fi
case "$pi_current_version" in
  ""|.|..|*[!0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz._+-]*)
    printf 'Managed Pi version file is invalid: %s\n' "$pi_current_file" >&2
    exit 1
    ;;
esac
pi_release_dir=$pi_agent_dir/install/releases/$pi_current_version
pi_release_bin=$pi_release_dir/node_modules/.bin/pi
if [ ! -x "$pi_release_bin" ]; then
  printf 'Managed Pi executable is missing: %s\n' "$pi_release_bin" >&2
  exit 1
fi
# Node.js installed by the Pi installer is not added to shell profiles, so put
# it on PATH for pi's shebang and for child processes: npm in pi update and
# commands run through pi's bash tool.
pi_node_bin=${XDG_DATA_HOME:-$HOME/.local/share}/pi-node/current/bin
if [ -x "$pi_node_bin/node" ]; then
  PATH=$pi_node_bin:$PATH
  export PATH
fi
# Pi 1.0.x needs Node >=22.19.0; older shell shims must not select Node 16.
pi_supported_node() {
  "$1" -e 'const v=process.versions.node.split(".").map(Number);process.exit(v[0]>22||(v[0]===22&&v[1]>=19)?0:1)' 2>/dev/null
}
pi_node=$(command -v node)
if ! pi_supported_node "$pi_node"; then
  pi_node=""
  for pi_candidate in /opt/homebrew/opt/node/bin/node /usr/local/bin/node "$HOME"/.volta/tools/image/node/*/bin/node; do
    if [ -x "$pi_candidate" ] && pi_supported_node "$pi_candidate"; then
      pi_node=$pi_candidate
      break
    fi
  done
  if [ -z "$pi_node" ]; then
    printf 'Pi requires Node >=22.19.0. Install a supported Node runtime.\n' >&2
    exit 1
  fi
  PATH=${pi_node%/*}:$PATH
  export PATH
fi
# Agent model JSON supplies launch defaults. Explicit CLI selections still win.
pi_has_model=false
case "${1-}" in
  install|remove|uninstall|update|list|config|auth|mcp) pi_has_model=true ;;
esac
for pi_argument in "$@"; do
  case "$pi_argument" in
    --model|--provider|--models) pi_has_model=true ;;
  esac
done
if [ "$pi_has_model" = false ]; then
  pi_model_file=${PI_CODING_AGENT_DIR:-$pi_agent_dir}/agents/models.json
  pi_default_model=$("$pi_node" -e 'const fs=require("node:fs");try {const c=JSON.parse(fs.readFileSync(process.argv[1],"utf8"));if(typeof c.default!=="string"||! /^[^/\s]+\/[^\s]+$/.test(c.default))throw Error("default must be provider/model");process.stdout.write(c.default);}catch(e){console.error("Cannot load model default: "+e.message);process.exit(1)}' "$pi_model_file") || exit 1
  set -- --model "$pi_default_model" "$@"
fi
PI_MANAGED_INSTALL_ROOT=$pi_agent_dir/install
export PI_MANAGED_INSTALL_ROOT
exec "$pi_release_bin" "$@"
